# CONTRÔLE DES MESSAGES D'ENREGISTREMENT
#
# Le seul auteur de ce dépôt est ILYES M. TRAD. Ce contrôle refuse tout message
# d'enregistrement qui porte une co-signature, une mention d'outil de
# génération, l'adresse d'un robot ou le lien d'une session de travail.
#
# Il s'active une fois par copie du dépôt (Windows, macOS ou Linux) :
#     git config core.hooksPath .githooks
# Il se vérifie lui-même :
#     sh .githooks/commit-msg --essai
# ─────────────────────────────────────────────────────────────────────────────

MOTIFS='^[[:space:]]*(co-authored-by|assisted-by|helped-by|generated-by)[[:space:]]*:|^[[:space:]]*[a-z0-9-]+-session[[:space:]]*:|generated (with|by)|noreply@|/code/session_|🤖'

propre() {
  # $1 : le fichier du message. Réussit si aucune ligne ne correspond aux motifs.
  ! grep -i -E "$MOTIFS" "$1" >/dev/null 2>&1
}

if [ "$1" = "--essai" ]; then
  echecs=0
  essai() {
    attendu="$1"; texte="$2"
    f=$(mktemp)
    printf '%s\n' "$texte" > "$f"
    if propre "$f"; then obtenu="accepte"; else obtenu="refuse"; fi
    rm -f "$f"
    if [ "$obtenu" = "$attendu" ]; then
      echo "  ok      $attendu : $(printf '%s' "$texte" | tr '\n' ' ' | cut -c1-70)"
    else
      echo "  ÉCHEC   attendu $attendu, obtenu $obtenu : $(printf '%s' "$texte" | tr '\n' ' ' | cut -c1-70)"
      echecs=$((echecs + 1))
    fi
  }
  echo "Contrôle des messages d'enregistrement — essai"
  essai refuse "Ajout du calcul

Co-Authored-By: Quelqu'un <noreply@example.com>"
  essai refuse "Ajout du calcul

co-authored-by: Une Personne <personne@example.com>"
  essai refuse "Correction

Assisted-by: un outil"
  essai refuse "Correction

Outil-Session: https://example.com/code/session_0123"
  essai refuse "Correction
https://example.com/code/session_0123"
  essai refuse "🤖 Generated with [Un outil](https://example.com)"
  essai refuse "Notes generated by a tool"
  essai accepte "travail-fr 0.4.2 — la version affichée dans l'accueil"
  essai accepte "Compatibilité avec la version 2.1 du client"
  essai accepte "Le tableau est généré par le script, puis relu"
  essai accepte "Session de travail du 22 octobre : trois corrections"
  if [ "$echecs" -eq 0 ]; then
    echo "Tous les cas passent."
    exit 0
  fi
  echo "$echecs cas en échec."
  exit 1
fi

if [ -z "$1" ] || [ ! -f "$1" ]; then
  echo "commit-msg : fichier du message introuvable" >&2
  exit 1
fi

if ! propre "$1"; then
  echo "REFUSÉ — ce message d'enregistrement porte une co-signature ou une mention d'outil :" >&2
  grep -n -i -E "$MOTIFS" "$1" >&2
  echo "Le seul auteur de ce dépôt est ILYES M. TRAD : retirez ces lignes, puis recommencez." >&2
  exit 1
fi
exit 0
